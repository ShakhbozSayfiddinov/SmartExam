{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=SmartExamDb;Username=postgres;Password=<YOUR_PASSWORD>"
  },
  "Jwt": {
    "Key": "<YOUR_SECRET_KEY_MIN_32_CHARS>",
    "Issuer": "SmartExam",
    "Audience": "SmartExam",
    "AccessTokenExpiresMinutes": 60,
    "RefreshTokenExpiresDays": 7
  },
  "FileStorage": {
    "Provider": "Local",
    "LocalPath": "uploads",
    "MaxFileSizeBytes": 5242880
  }
}
